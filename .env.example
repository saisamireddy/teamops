DEBUG=True
SECRET_KEY=change-me-in-production

# Comma-separated hostnames for Django.
ALLOWED_HOSTS=localhost,127.0.0.1

# Include scheme (https://...) and comma-separate multiple origins.
CSRF_TRUSTED_ORIGINS=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Preferred DB setting for production.
DATABASE_URL=postgres://user:password@localhost:5432/teamops
DB_SSL_REQUIRE=False

# Redis / async stack.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Security controls (production).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional throttling and logs.
THROTTLE_USER_RATE=1000/day
THROTTLE_ANON_RATE=100/day
LOG_LEVEL=INFO

# Invite and email flow.
FRONTEND_URL=http://localhost:4200
INVITE_ACCEPT_BASE_URL=http://localhost:4200/accept-invite
INVITE_TOKEN_TTL_HOURS=72
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@teamops.local
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
